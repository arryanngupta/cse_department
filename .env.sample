# ---------------------------------------------------------------------------
# Backend environment (copy to backend/.env — never commit the filled-in file)
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local development points at a local MySQL; production points at the managed
# cloud instance. There are no in-code defaults: the server refuses to start if
# any of DB_HOST / DB_NAME / DB_USER / DB_PASS is missing.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lnmiit_cse

# TLS. Defaults to on when NODE_ENV=production, off otherwise. Set explicitly to
# override. Managed providers (Aiven, RDS, DigitalOcean, Railway) require it.
DB_SSL=false
# Optional: PEM contents of the provider's CA certificate. When set, the
# certificate chain is fully verified instead of merely encrypted.
DB_SSL_CA=

# Connection pool. The defaults (max 10 in production, 5 locally) suit a single
# Render instance on an entry-tier managed database.
DB_POOL_MAX=
DB_POOL_MIN=
DB_POOL_ACQUIRE=
DB_POOL_IDLE=

# SQL query logging. Off in production regardless; set true to force it on.
DB_LOGGING=false

# Timezone used for DATE/DATETIME handling. Defaults to +05:30 (IST).
DB_TIMEZONE=+05:30

# --- Auth ---------------------------------------------------------------
# Required. Minimum 32 characters; the server refuses to start without it.
# Generate with:  openssl rand -hex 32
JWT_SECRET=
# Token lifetime. Defaults to 24h.
JWT_EXPIRES_IN=24h

# Failed login attempts allowed per 15 minutes. Defaults to 10.
# The test suite intentionally performs failed logins, so raise this (e.g.
# 1000) when running tests against an instance; leave it at the default in
# production.
AUTH_RATE_LIMIT_MAX=

# General API requests allowed per 15 minutes, per IP. Defaults to 5000.
# Deliberately high: a department site is read mostly from the campus network,
# where hundreds of people share one public address — the old ceiling of 600
# meant a lecture hall browsing the site locked everyone out for 15 minutes.
# Per process, so several instances multiply the effective limit.
API_RATE_LIMIT_MAX=

# --- Server ---------------------------------------------------------------
PORT=3022
NODE_ENV=development

# Comma-separated list of exact origins allowed to call the API.
# Production must list the real frontend origins — wildcards are not accepted.
ORIGIN=http://localhost:3021

UPLOAD_DIR=./src/uploads

# --- Cloudinary (image and PDF hosting) -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SEO ---------------------------------------------------------------
SITE_DOMAIN=https://cse.lnmiit.ac.in

# --- Email ----------------------------------------------------------------
# Optional. With EMAIL_PROVIDER=none the app runs normally and simply does not
# send mail: every send is a no-op that is logged, never an error. Event
# registration confirmations and password-reset links are the two senders.
#
# Provider: none | smtp | resend  (default: none)
EMAIL_PROVIDER=none
# Envelope From. Required once a provider is set.
EMAIL_FROM=
# Optional display name, e.g. "LNMIIT CSE Department".
EMAIL_FROM_NAME=

# Only for EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Only for EMAIL_PROVIDER=resend:
RESEND_API_KEY=

# --- Password reset -------------------------------------------------------
# How long a reset link stays valid. Tokens are single-use and only their
# SHA-256 hash is stored, so a database read cannot recover a usable link.
PASSWORD_RESET_TTL_MINUTES=60

# --- Scheduled publishing -------------------------------------------------
# A polling worker applies due publish_at / unpublish_at times. Schedules live
# in the database, not in memory, so a restart cannot lose them — the worker
# ticks once on boot to catch up on anything that came due while it was down.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# --- AI assistant ---------------------------------------------------------
# Optional. With no key the assistant still runs: it answers from the retrieval
# layer with citations, and simply does not generate prose. See
# docs/architecture.md.
#
# Provider: groq | grok | anthropic | openai | none  (default: none)
#
# NOTE: groq and grok are different providers, not a typo.
#   groq = Groq, a fast-inference host for open models (console.groq.com, gsk_…)
#   grok = xAI's own model               (console.x.ai,     xai-…)
AI_PROVIDER=none
AI_API_KEY=
# Model for anthropic/openai. Grok uses XAI_MODEL below.
AI_MODEL=
# Hard ceiling on generated tokens per answer, to bound cost.
AI_MAX_OUTPUT_TOKENS=800
# Requests per hour against the assistant. Keyed per authenticated user when a
# session exists, per IP otherwise — see middleware/rateLimiter.js.
AI_RATE_LIMIT_PER_HOUR=30

# Hard timeout on a provider call, in milliseconds.
AI_TIMEOUT_MS=30000

# --- Grok (xAI) -----------------------------------------------------------
# To use Grok, set AI_PROVIDER=grok above and fill these in.
#
# The key is read on the backend only. Never put it in a VITE_* variable: those
# are compiled into the browser bundle and are readable by anyone who loads the
# site.
#
# Billing: xAI's published pricing has no free tier. grok-4.7 is roughly
# $2/$6 per million input/output tokens at the time of writing. Check
# https://console.x.ai for your account's actual credits before enabling this —
# an unconfigured provider is a supported state, a surprise invoice is not.
XAI_API_KEY=
# Defaults to grok-4.7. Other documented ids include grok-4.6, grok-4.5,
# grok-4.3 and grok-build-0.1. Verify against https://docs.x.ai/docs/models —
# a model your account cannot access returns 404.
XAI_MODEL=

# --- Groq ------------------------------------------------------------------
# To use Groq, set AI_PROVIDER=groq above and fill these in.
#
# OpenAI-compatible API at https://api.groq.com/openai/v1/chat/completions.
# Backend only — never a VITE_* variable.
#
# Groq DOES have a free tier, which is the practical difference from xAI.
# Measured against a live free-tier key:
#   x-ratelimit-limit-requests: 1000   (per day)
#   x-ratelimit-limit-tokens:   8000   (per minute)
# A grounded assistant request sends roughly 2000 tokens, so a handful of rapid
# questions exhausts the per-minute budget and the assistant degrades to
# retrieval-only until it resets. Keep AI_RATE_LIMIT_PER_HOUR modest.
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b. Confirm what your account actually has with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# Groq's own docs example names llama-3.3-70b-versatile, which is NOT available
# on every account — check before setting it.
GROQ_MODEL=

# --- Assistant retrieval tuning -------------------------------------------
# Minimum accumulated retrieval score for a passage to count as evidence.
# Deliberately low: on this corpus the score does not separate on-topic from
# off-topic questions (see the comment in services/assistantService.js for the
# measurements). Subject scope is enforced by services/assistantScope.js, not
# by this number. Re-measure before raising it.
ASSISTANT_MIN_SCORE=5
# Passages required before an answer is generated at all.
ASSISTANT_MIN_PASSAGES=1

# ---------------------------------------------------------------------------
# Frontend environment (copy to client/.env)
# ---------------------------------------------------------------------------
# Base URL of the API. Must NOT point at localhost in production.
# Never put secrets in VITE_* variables — they are compiled into the bundle and
# are readable by anyone who loads the site.
VITE_API_BASE_URL=http://localhost:3022

# Public origin of the site itself. Used to build canonical URLs, Open Graph
# tags and schema.org JSON-LD. Getting this wrong points every canonical tag at
# the wrong host, so set it per environment.
VITE_SITE_URL=https://cse.lnmiit.ac.in
